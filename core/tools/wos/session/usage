#!/usr/bin/env python3
# Usage: core/tools/wos/session/usage [--project <slug>] [--top N] — where session spend goes: by model,
# by context size, and what one more turn costs. Reads the local transcripts; no network, no model.
#
# Exists because ROADMAP Frente 9 was steered for weeks by numbers from a single 24h window, two
# of which were false. Any claim about where usage goes should be re-runnable in one command.
import json
import sys
from collections import defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from session_cost import turn_cost

ROOT = Path.home() / '.claude' / 'projects'
BUCKETS = [50, 100, 150, 200, 250, 300, 400, 10 ** 6]


def turns(project: str):
	"""Every main-chain assistant turn: (context it carried, what it cost, model, session)."""
	directory = ROOT / project
	if not directory.is_dir():
		sys.exit(f'no such project: {directory}')
	for path in sorted(directory.glob('*.jsonl')):
		with path.open(errors='replace') as handle:
			for line in handle:
				if '"usage"' not in line:
					continue
				try:
					event = json.loads(line)
				except json.JSONDecodeError:
					continue
				if event.get('type') != 'assistant' or event.get('isSidechain'):
					continue
				usage = (event.get('message') or {}).get('usage') or {}
				model = (event.get('message') or {}).get('model') or ''
				if not usage or model.startswith('<'):
					continue
				context = (usage.get('input_tokens', 0)
				           + usage.get('cache_read_input_tokens', 0)
				           + usage.get('cache_creation_input_tokens', 0))
				yield context, turn_cost(model, usage), model, path.stem


def bucket_of(context: int) -> int:
	return next(edge for edge in BUCKETS if context < edge * 1000)


def main() -> None:
	args = sys.argv[1:]
	project = args[args.index('--project') + 1] if '--project' in args else '-mnt-workspace'
	rows = list(turns(project))
	if not rows:
		sys.exit(f'{project}: no assistant turns with usage')

	total = sum(cost for _c, cost, _m, _s in rows)
	by_model: dict = defaultdict(float)
	by_bucket: dict = defaultdict(lambda: [0, 0.0])
	by_session: dict = defaultdict(float)
	reread = 0
	for context, cost, model, session in rows:
		by_model[model] += cost
		slot = by_bucket[bucket_of(context)]
		slot[0] += 1
		slot[1] += cost
		by_session[session] += cost
		reread += context

	print(f'{project} · {len(by_session)} sessions · {len(rows):,} turns · ${total:,.2f}\n')

	print('by model')
	for model, cost in sorted(by_model.items(), key=lambda kv: -kv[1]):
		print(f'  {model:<28} ${cost:9,.2f}  {cost / total:5.1%}')

	print('\nby the context the turn carried — the cost of one more turn, and what it adds up to')
	# The last column is the share of spend at or above this row's *lower* edge — read the <200k
	# row as "this much is paid from 150k up". It is the number that sets CTX_WARN/CTX_LOUD.
	print(f"  {'context':>9} {'turns':>7} {'$/turn':>8} {'spent':>10} {'share':>7} {'>=floor':>8}")
	above = total
	for edge in BUCKETS:
		count, cost = by_bucket[edge]
		if not count:
			continue
		label = f'<{edge}k' if edge < 10 ** 6 else '>400k'
		print(f'  {label:>9} {count:>7,} {cost / count:>8.3f} {cost:>10,.2f} '
		      f'{cost / total:>6.1%} {above / total:>6.1%}')
		above -= cost

	ranked = sorted(by_session.values(), reverse=True)
	decile = max(1, len(ranked) // 10)
	print(f'\ntop {decile} sessions = ${sum(ranked[:decile]):,.2f} '
	      f'({sum(ranked[:decile]) / total:.1%} of spend)')
	print(f'context re-read across all turns: {reread / 1e6:,.1f}M tokens — every turn pays for the '
	      f'whole thread,\nwhich is why a long session costs more than the same work split in two.')


if __name__ == '__main__':
	main()
