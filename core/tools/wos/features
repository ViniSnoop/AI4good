#!/mnt/workspace/.venv/bin/python3
# Usage: core/tools/wos/features [--group <g>] [--findings] [--on <slug>] [--off <slug>] [--check] — list every toggleable capability from core/features.txt with its answer in core/profile.txt; --findings counts what cannot be switched off; --check exits 1 on any registry/profile disagreement
from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / 'core' / 'hooks'))

import feature_law as law  # noqa: E402  — path is set above, which is the house pattern

PROFILE = ROOT / 'core' / 'profile.txt'
MARK = {'on': 'on ', 'off': 'OFF'}


def _write_toggle(slug: str, value: str) -> int:
    """Rewrite one answer in place. The file is the interface, so the edit is a line swap and
    every comment, ordering and setting survives it untouched."""
    if slug not in law.slugs():
        print(f'no such feature: {slug!r} — it is not declared in core/features.txt',
              file=sys.stderr)
        return 1
    lines = PROFILE.read_text(encoding='utf-8').splitlines(keepends=True)
    for i, line in enumerate(lines):
        parts = line.rstrip('\n').split('\t')
        if len(parts) == 3 and parts[0] == 'toggle' and parts[1] == slug:
            lines[i] = f'toggle\t{slug}\t{value}\n'
            PROFILE.write_text(''.join(lines), encoding='utf-8')
            print(f'{slug} -> {value}')
            return 0
    print(f'{slug} is declared but has no answer in core/profile.txt', file=sys.stderr)
    return 1


def _listing(rows: list) -> int:
    """Grouped, because the grouping is what makes a feature findable in a tree this size."""
    toggles = law.load_profile()['toggle']
    for group in sorted({r['group'] for r in rows}):
        members = [r for r in rows if r['group'] == group]
        print(f'\n{group}  ({len(members)})')
        for r in members:
            state = MARK.get(toggles.get(r['slug'], 'on'), 'on ')
            wired = '' if r['wired'] not in ('-', '') else '   [not switchable]'
            print(f"  {state}  {r['slug']:24s} {r['enforcement']:10s} {r['scope']:8s}{wired}")
    return 0


def _findings() -> int:
    """A capability that cannot be switched off is entangled with the scaffold rather than sitting
    on it, so it is invisible to an ablation. The count is the number that has to come down."""
    rows = law.findings()
    for r in rows:
        print(f"  {r['slug']:24s} {r['group']:14s} {r['enforcement']}")
    total = len(law.load_registry())
    print(f'\n{len(rows)} of {total} declared features cannot be switched off yet.')
    print('Wiring one means calling feature_law.is_enabled() in the file that enforces it,')
    print("then naming that file in the registry's `wired` column.")
    return 0


def _check() -> int:
    """Every disagreement between the two files, in one pass. Exits 1 on any."""
    registry, toggles = law.load_registry(), law.load_profile()['toggle']
    declared = {r['slug'] for r in registry}
    problems = [f'declared but unanswered: {s}' for s in sorted(declared - set(toggles))]
    problems += [f'answered but undeclared: {s}' for s in sorted(set(toggles) - declared)]
    problems += [f"{r['slug']}: bad value in a closed column"
                 for r in registry
                 if r['group'] not in law.GROUPS
                 or r['enforcement'] not in law.ENFORCEMENT
                 or r['scope'] not in law.SCOPES]
    problems += [f'{s}: answer is neither on nor off' for s, v in sorted(toggles.items())
                 if v not in ('on', 'off')]
    for p in problems:
        print(f'  {p}', file=sys.stderr)
    print(f'{len(problems)} disagreement(s) between core/features.txt and core/profile.txt.')
    return 1 if problems else 0


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('--group', help='list one group only')
    ap.add_argument('--findings', action='store_true', help='what cannot be switched off yet')
    ap.add_argument('--on', metavar='SLUG', help='switch a feature on, in core/profile.txt')
    ap.add_argument('--off', metavar='SLUG', help='switch a feature off, in core/profile.txt')
    ap.add_argument('--check', action='store_true', help='exit 1 on any disagreement')
    args = ap.parse_args()

    if args.on:
        return _write_toggle(args.on, 'on')
    if args.off:
        return _write_toggle(args.off, 'off')
    if args.check:
        return _check()
    if args.findings:
        return _findings()

    rows = law.load_registry()
    if args.group:
        rows = [r for r in rows if r['group'] == args.group]
        if not rows:
            print(f'no such group: {args.group!r} — one of {sorted(law.GROUPS)}', file=sys.stderr)
            return 1
    return _listing(rows)


if __name__ == '__main__':
    sys.exit(main())
